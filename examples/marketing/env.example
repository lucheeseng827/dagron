# Engine configuration for the marketing pack.
#
#   cp examples/marketing/env.example .env.marketing
#   set -a; . ./.env.marketing; set +a
#   dagron examples/marketing/01_lead_capture_multisource.yaml
#
# Nothing here is dagron-specific magic: secrets resolve through the standard
# `value_from: { secret: NAME }` seam, so a SOPS / External-Secrets / Vault-Agent
# setup that already mounts files works by setting DAGRON_SECRETS_DIR instead of
# the DAGRON_SECRET_* variables below.

# ── State ────────────────────────────────────────────────────────────────────
# SQLite is the default (single file, no server). Switch to Postgres for
# multi-node HA — the workflows do not change.
# DATABASE_URL=postgres://dagron:dagron@localhost:5432/dagron

# ── Artifacts ────────────────────────────────────────────────────────────────
# Every task in this pack writes to $DAGRON_ARTIFACTS (the run's shared dir) and
# reads what upstream tasks left there. Without this, that variable is unset.
DAGRON_ARTIFACT_DIR=/var/lib/dagron/artifacts
# Cloud artifact store (S3 / GCS / Azure). Tasks get $DAGRON_ARTIFACTS_URL and
# $DAGRON_CHECKPOINT_URL — 06's spot-GPU resume needs this to survive a node.
DAGRON_ARTIFACT_URL=s3://acme-lake/dagron-artifacts

# ── Concurrency pools ────────────────────────────────────────────────────────
# The single most important line in this file. Every third-party API in the pack
# is rate-limited; a pool is a shared budget across *all* runs, so a 30-day
# backfill of 05 cannot starve 03's speed-to-lead routing of HubSpot quota.
POOLS=crm-api=8,ads-api=4,enrich-api=4,activation-api=6,seo-api=2

# ── Scheduling ───────────────────────────────────────────────────────────────
CRON_CONFIG=examples/marketing/cron.yaml.example
WAIT_POLL_SECS=15          # how often HTTP/dataset sensors are polled

# ── Streaming (14, 15) ───────────────────────────────────────────────────────
# SOURCE=stream
# STREAM_PATH=/var/lib/dagron/events.ndjson

# ── Console / API ────────────────────────────────────────────────────────────
API_ADDR=127.0.0.1:8787    # keep on loopback: the management API has no auth
DAGRON_API_URL=http://127.0.0.1:8787

# ── Environment variables referenced as {{ env.NAME }} ───────────────────────
# In production these live in a UI-managed environment ("prod" / "staging"),
# which is what `environment: prod` in each workflow selects. Listed here so the
# pack runs from a shell too.
LAKE_BUCKET=acme-lake
MODEL_BUCKET=acme-models
HUBSPOT_PORTAL_ID=8123456

# ── Slack notifications ──────────────────────────────────────────────────────
# `notify.slack.webhook_url` templates against a run's PARAMETERS, not
# {{ env.* }} — so the workflows take it as a `slack_webhook` parameter. Either
# pass it at submit (-p slack_webhook=https://hooks.slack.com/...) or, better,
# set an instance-wide default once in the console (sidebar → Notifications),
# which the engine applies to every run in addition to per-workflow blocks.

# ── Secrets (value_from: { secret: NAME }) ───────────────────────────────────
# Resolved at dispatch and masked in task output. Prefer DAGRON_SECRETS_DIR or a
# UI-managed environment; these are the shell-friendly form.
# DAGRON_SECRETS_DIR=/run/secrets/dagron
DAGRON_SECRET_HUBSPOT_PRIVATE_APP_TOKEN=
DAGRON_SECRET_SALESFORCE_CLIENT_SECRET=
DAGRON_SECRET_SNOWFLAKE_PASSWORD=
DAGRON_SECRET_GOOGLE_ADS_REFRESH_TOKEN=
DAGRON_SECRET_META_ADS_ACCESS_TOKEN=
DAGRON_SECRET_LINKEDIN_ADS_TOKEN=
DAGRON_SECRET_REDDIT_ADS_TOKEN=
DAGRON_SECRET_GA4_SERVICE_ACCOUNT_JSON=
DAGRON_SECRET_GSC_SERVICE_ACCOUNT_JSON=
DAGRON_SECRET_AHREFS_API_TOKEN=
DAGRON_SECRET_CLEARBIT_API_KEY=
DAGRON_SECRET_ZOOMINFO_API_KEY=
DAGRON_SECRET_SIXSENSE_API_KEY=
DAGRON_SECRET_DEMANDBASE_API_KEY=
DAGRON_SECRET_G2_BUYER_INTENT_TOKEN=
DAGRON_SECRET_ZOOM_SERVER_TO_SERVER_TOKEN=
DAGRON_SECRET_SENDGRID_API_KEY=
DAGRON_SECRET_CUSTOMERIO_API_KEY=
DAGRON_SECRET_SEGMENT_WRITE_KEY=
DAGRON_SECRET_STRIPE_RESTRICTED_KEY=
DAGRON_SECRET_ZENDESK_API_TOKEN=
DAGRON_SECRET_RECAPTCHA_SECRET_KEY=
DAGRON_SECRET_IPQUALITYSCORE_KEY=
DAGRON_SECRET_ZEROBOUNCE_API_KEY=
DAGRON_SECRET_LITMUS_API_KEY=
DAGRON_SECRET_GLOCKAPPS_API_KEY=
DAGRON_SECRET_NOTION_API_TOKEN=
DAGRON_SECRET_ANTHROPIC_API_KEY=
DAGRON_SECRET_SLACK_BOT_TOKEN=
DAGRON_SECRET_GITHUB_PAT=
# 08 dispatches child runs through the API edge and needs a token for it
DAGRON_SECRET_DAGRON_API_TOKEN=

# ── Commit statuses (16, 20) ─────────────────────────────────────────────────
# notify.git is best-effort and only active when this is set.
# GITHUB_TOKEN=

# ── Kubernetes / Docker executors (04, 06, 17, 18) ───────────────────────────
# EXECUTOR=kubernetes
# K8S_NAMESPACE=marketing-pipelines
# Runner classes map to node pools: spot-gpu / ondemand-gpu / cpu
