        exec "$ci_exec"
      fi
    done
    printf '%s\n' "::dagron-ci::error::this job's steps need dagron-ci-exec (step protocol 2), and none is at /dagron/bin or on PATH: the engine installs it where its operator set DAGRON_CI_EXEC_IMAGE" >&2
    exit 125
  workspace:
    checkout:
      commit: '{{ ci_sha }}'
      repository: https://{{ ci_forge_host }}/{{ ci_repo }}.git
  env:
  - name: CI
    value: 'true'
  - name: CI_COMMIT_BEFORE_SHA
    value: '0000000000000000000000000000000000000000'
  - name: CI_COMMIT_BRANCH
    value: main
  - name: CI_COMMIT_REF_NAME
    value: main
  - name: CI_COMMIT_REF_SLUG
    value: main
  - name: CI_COMMIT_SHA
    value: 4b4708e725f29891d22b4c96af9f0a403ff51c7c
  - name: CI_COMMIT_SHORT_SHA
    value: 4b4708e7
  - name: CI_DEFAULT_BRANCH
    value: main
  - name: CI_JOB_NAME
    value: build
  - name: CI_JOB_STAGE
    value: test
  - name: CI_NODE_INDEX
    value: '2'
  - name: CI_NODE_TOTAL
    value: '3'
  - name: CI_PIPELINE_SOURCE
    value: push
  - name: CI_PROJECT_NAME
    value: app
  - name: CI_PROJECT_NAMESPACE
    value: group
  - name: CI_PROJECT_PATH
    value: group/app
  - name: CI_PROJECT_PATH_SLUG
    value: group-app
  - name: CI_PROJECT_URL
    value: https://gitlab.example/group/app
  - name: CI_SERVER_HOST
    value: gitlab.example
  - name: CI_SERVER_URL
    value: https://gitlab.example
  - name: GITLAB_CI
    value: 'true'
  - name: PROFILE
    value: release
  - name: TARGET
    value: aarch64
  - name: CI_STEP_PROTOCOL
    value: '2'
  - name: CI_STEP_COUNT
    value: '1'
  - name: CI_STEP_1_NAME
    value: script
  - name: CI_STEP_1_RUN
    value: |
      set -e
      (set -o pipefail) 2>/dev/null && set -o pipefail
      export CI_PROJECT_DIR="$PWD"
      printf '$ %s\n' 'cargo build --target $TARGET'
      cargo build --target $TARGET
  - name: CI_STEP_1_SHELL
    value: auto
