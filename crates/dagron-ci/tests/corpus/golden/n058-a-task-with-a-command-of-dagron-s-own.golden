runs

parameters:
  ci_base_ref: ""
  ci_base_sha: ""
  ci_event: "push"
  ci_forge_host: "github.com"
  ci_group: "refs/heads/main"
  ci_pr: ""
  ci_ref: "refs/heads/main"
  ci_repo: "acme/widgets"
  ci_sha: "4b4708e725f29891d22b4c96af9f0a403ff51c7c"
  ci_trust: "trusted"

workflow:
name: ci
parameters:
  ci_event: ''
  ci_ref: ''
  ci_sha: ''
  ci_base_sha: ''
  ci_base_ref: ''
  ci_pr: ''
  ci_repo: ''
  ci_forge_host: ''
  ci_group: ''
  ci_trust: ''
tags:
- ci
task_defaults:
  timeout_secs: 3600
  env:
  - name: CI_EVENT
    value: '{{ ci_event }}'
  - name: CI_REF
    value: '{{ ci_ref }}'
  - name: CI_SHA
    value: '{{ ci_sha }}'
  - name: CI_BASE_SHA
    value: '{{ ci_base_sha }}'
  - name: CI_BASE_REF
    value: '{{ ci_base_ref }}'
  - name: CI_PR
    value: '{{ ci_pr }}'
  - name: CI_REPO
    value: '{{ ci_repo }}'
  - name: CI_FORGE_HOST
    value: '{{ ci_forge_host }}'
  - name: CI_GROUP
    value: '{{ ci_group }}'
  - name: CI_TRUST
    value: '{{ ci_trust }}'
tasks:
- name: hello
  command:
  - echo
  - hello
  docker_image: docker.io/library/alpine:3.20
