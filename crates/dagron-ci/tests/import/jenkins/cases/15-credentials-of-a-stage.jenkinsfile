// One variable, a secret of each stage's: each stage's steps read their own.
pipeline {
    agent { docker { image 'node:22-bookworm-slim' } }
    stages {
        stage('Test') {
            steps { sh 'npm test' }
        }
        stage('Deploy staging') {
            environment { TOKEN = credentials('staging-token') }
            steps { sh './deploy.sh staging' }
        }
        stage('Deploy prod') {
            when { branch 'main' }
            environment { TOKEN = credentials('prod-token') }
            steps { sh './deploy.sh prod' }
        }
        stage('Publish') {
            steps {
                withCredentials([string(credentialsId: 'npm-token', variable: 'TOKEN')]) {
                    sh 'npm publish'
                }
                withCredentials([string(credentialsId: "deploy-${params.TARGET}", variable: 'DEPLOY_KEY')]) {
                    sh './announce.sh'
                }
            }
        }
    }
}
