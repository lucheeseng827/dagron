// A release that waits for a person's yes, on main alone.
pipeline {
    agent { docker { image 'alpine:3.20' } }
    stages {
        stage('Build') {
            steps { sh './build.sh' }
        }
        stage('Release') {
            when { branch 'main' }
            input {
                message 'Release this build?'
                ok 'Release'
                submitter 'release-managers'
            }
            steps { sh './release.sh' }
        }
    }
}
