// Credentials, from the environment and around steps.
pipeline {
    agent { docker { image 'alpine:3.20' } }
    environment {
        NPM_TOKEN = credentials('npm-token')
        REGISTRY = 'registry.example.com'
        IMAGE = "${REGISTRY}/team/app"
    }
    stages {
        stage('Publish') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'registry', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    sh 'echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin "$REGISTRY"'
                }
                withCredentials([string(credentialsId: 'slack-hook', variable: 'HOOK'), file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh 'curl -fsS -X POST "$HOOK" -d "published $IMAGE"'
                }
                sh 'npm publish --userconfig=.npmrc # uses $NPM_TOKEN_PSW'
            }
        }
    }
}
